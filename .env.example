# GEMINI_API_KEY: Required for Google Gemini API calls (cross-system synthesis & macro consensus extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model variant for Gemini (e.g., gemini-2.5-flash, gemini-2.5-pro).
GEMINI_MODEL="gemini-2.5-flash"

# ARK_API_KEY: Volcengine Ark API key for Doubao (火山引擎豆包大模型 - 原典中译与概念考订).
ARK_API_KEY=

# DOUBAO_ENDPOINT_ID: Volcengine Doubao model endpoint ID (e.g., ep-xxxx or doubao-pro-32k).
DOUBAO_ENDPOINT_ID="doubao-pro-32k"

# DOUBAO_BASE_URL: Volcengine Ark API endpoint URL.
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# RTX 5060 single-card (do not set GPU_COUNT=2 until a second card is installed)
GPU_COUNT=1
GPU_DEVICES="0"
DEVICE_MAP="auto"
MODEL_PATH="brie-v2-3b/Qwen2.5-Phil"

# Prompt adapter: auto | alpaca (Fireball-12B) | chatml (Qwen/brie) | gemma (Veritas) | raw_template
PROMPT_FORMAT="auto"
# Optional OpenAI-compatible local server (llama.cpp / Ollama). Empty = in-process HuggingFace.
# 5060 first path: FastAPI stays CPU-only and forwards to this URL.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY="philo-everos"
LOCAL_LLM_MODEL="qwen2.5:7b"
# Only set 1 if you intentionally stack two GPU occupants (usually a mistake).
ALLOW_GPU_SHARE=0
TARGET_HARDWARE="RTX_5060"

# Vector Database & Cache — literature only (consensus axioms stay in-repo JSON)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_LITERATURE_COLLECTION="philo_literature"
DOUBAO_EMBEDDING_MODEL="doubao-embedding-large-text-240915"
DOUBAO_EMBEDDING_DIM=2048
REDIS_HOST="localhost"
REDIS_PORT=6379

# Official EverOS sidecar (everos server start). Empty = disabled; do not merge EverOS source.
EVEROS_SIDECAR_URL=
EVEROS_APP_ID="philo-everos"
EVEROS_PROJECT_ID="seminar"

# Python Backend Service URL (for Node.js gateway)
PYTHON_BACKEND_URL="http://localhost:8000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

