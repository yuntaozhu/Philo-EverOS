# GEMINI_API_KEY: Required for Google Gemini API calls (cross-system synthesis & macro consensus extraction).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model variant for Gemini (e.g., gemini-2.5-flash, gemini-2.5-pro).
GEMINI_MODEL="gemini-2.5-flash"

# ARK_API_KEY: Volcengine Ark API key for Doubao (火山引擎豆包大模型 - 原典中译与概念考订).
ARK_API_KEY=

# DOUBAO_ENDPOINT_ID: Volcengine Doubao model endpoint ID (e.g., ep-xxxx or doubao-pro-32k).
DOUBAO_ENDPOINT_ID="doubao-pro-32k"

# DOUBAO_BASE_URL: Volcengine Ark API endpoint URL.
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Dual RTX 5090 GPU Settings
GPU_COUNT=2
GPU_DEVICES="0,1"
DEVICE_MAP="auto"
MODEL_PATH="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"

# Vector Database & Cache
QDRANT_HOST="localhost"
QDRANT_PORT=6333
REDIS_HOST="localhost"
REDIS_PORT=6379

# Python Backend Service URL (for Node.js gateway)
PYTHON_BACKEND_URL="http://localhost:8000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

